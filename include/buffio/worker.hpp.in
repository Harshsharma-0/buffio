#ifndef BUFFIO_WORKER
#define BUFFIO_WORKER

@BUFFIO_WORKER_BACKEND_INCLUDE@
#include "buffio/macro.hpp"
#include "buffio/task.hpp"

namespace buffio{
class Worker{

  public:
    BUFFIO_CLASS_PROTECT(Worker);
    int init(int numWorker);
    int init(int numWorker,unsigned int queueOrder);
    bool push(buffio::vTask task) {
      return task_queue.enqueue(task);
    };
    bool push(buffio::op_vec vec);
    int run();
    ~Worker();
     Worker();
  private:
  int flush();
  buffio::Queue<buffio::vTask> task_queue;
  WorkerState state_;
};
};
#endif
